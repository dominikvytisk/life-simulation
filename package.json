{
  "name": "life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "esbuild scripts/bench.ts --bundle --format=esm --platform=node --outfile=.bench.mjs --log-level=error && node .bench.mjs",
    "sweep": "esbuild scripts/seedSweep.ts --bundle --format=esm --platform=node --outfile=.sweep.mjs --log-level=error && node .sweep.mjs",
    "voice": "esbuild scripts/acousticProbe.ts --bundle --format=esm --platform=node --outfile=.voice.mjs --log-level=error && node .voice.mjs",
    "experiment": "esbuild scripts/experimentCheck.ts --bundle --format=esm --platform=node --outfile=.exp.mjs --log-level=error && node .exp.mjs",
    "serve:subpath": "node scripts/serveSubpath.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@webgpu/types": "^0.1.64",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
